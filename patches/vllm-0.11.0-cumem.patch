         assert cumem_available, "cumem allocator is not available"
         if CuMemAllocator.instance is None:
             CuMemAllocator.instance = CuMemAllocator()
+            atexit.register(CuMemAllocator.instance.release_pools)
         return CuMemAllocator.instance
+
+    def release_pools(self) -> None:
+        """Release memory pools before their backing allocators are destroyed."""
+        entries = list(self.allocator_and_pools.values())
+        self.allocator_and_pools.clear()
+        pools = [entry[0] for entry in entries]
+        allocators = [entry[1] for entry in entries]
+        entries.clear()
+        pools.clear()
+        gc.collect()
+        allocators.clear()
 
     def __init__(self):
         conf = os.environ.get("PYTORCH_CUDA_ALLOC_CONF", "")
